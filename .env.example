# Copia este archivo como .env y completa los valores (el .env nunca se sube a GitHub)
# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# PostHog (estadísticas), opcional
VITE_POSTHOG_KEY=
# NUNCA pongas aquí la service_role key ni la clave de Anthropic: esas van solo en Supabase Secrets
# Función que sugiere las opciones dietéticas de la carta (supabase/functions/analizar-carta)
VITE_MENU_DIET_URL=
